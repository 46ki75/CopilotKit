{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@copilotkit/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "jsxImportSource": "@builder.io/qwik"
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "build", "node_modules"]
}
