{
  "name": "@cloud.ikuma/copilotkit-qwik",
  "version": "0.1.0",
  "description": "CopilotKit bindings for Qwik",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@copilotkit/core": "workspace:*",
    "@copilotkit/shared": "workspace:*"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.19.2",
    "@copilotkit/typescript-config": "workspace:*",
    "tsdown": "^0.20.3",
    "typescript": "5.8.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@builder.io/qwik": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
