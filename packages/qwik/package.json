{
  "name": "@cloud.ikuma/copilotkit-qwik",
  "version": "0.2.0",
  "description": "Individual Qwik package for CopilotKit, providing tools and components to build AI assistants and automation with Qwik.",
  "keywords": [
    "ai",
    "assistant",
    "automation",
    "copilot",
    "copilotkit",
    "javascript",
    "qwik"
  ],
  "homepage": "https://github.com/46ki75/CopilotKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/46ki75/CopilotKit.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "format": "oxfmt --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.52",
    "@copilotkit/core": "workspace:*",
    "@copilotkit/shared": "workspace:*"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.19.2",
    "@copilotkit/typescript-config": "workspace:*",
    "tsdown": "^0.20.3",
    "typescript": "5.8.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@builder.io/qwik": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
