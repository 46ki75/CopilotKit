{
  "name": "@cloud.ikuma/copilotkit-qwik",
  "version": "0.12.0",
  "description": "Individual Qwik package for CopilotKit, providing tools and components to build AI assistants and automation with Qwik.",
  "keywords": [
    "ai",
    "assistant",
    "automation",
    "copilot",
    "copilotkit",
    "javascript",
    "qwik"
  ],
  "homepage": "https://github.com/46ki75/CopilotKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/46ki75/CopilotKit.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/index.css -m && node scripts/scope-preflight.mjs ./dist/index.css",
    "build": "tsdown && pnpm run build:css",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "format": "oxfmt --write .",
    "lint": "oxlint --fix . -A no-img-element",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.52",
    "@ag-ui/core": "0.0.52",
    "@copilotkit/core": "workspace:*",
    "@copilotkit/shared": "workspace:*",
    "zod": "^3.23.3"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.19.2",
    "@copilotkit/typescript-config": "workspace:*",
    "@tailwindcss/cli": "^4.1.11",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.16",
    "oxlint": "^1.51.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^4.0.8",
    "tsdown": "^0.20.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.8.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@builder.io/qwik": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
